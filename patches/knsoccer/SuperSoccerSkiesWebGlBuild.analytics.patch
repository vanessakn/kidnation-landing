+    private static string AddAnalyticsHooks(string html)
+    {
+        const string analyticsAnchor = "      const unityError = document.querySelector(\"#unity-error\");\n";
+        const string retryHandler = "      document.querySelector(\"#unity-retry\").addEventListener(\"click\", () => window.location.reload());";
+        const string analyticsBridgeScript = "      const kidNationAllowedParents = { \"https://www.kidnation.com\": true, \"https://kidnation.com\": true };\n"
+            + "      let kidNationParentOrigin = \"\";\n"
+            + "      try {\n"
+            + "        const referrerOrigin = document.referrer ? new URL(document.referrer).origin : \"\";\n"
+            + "        if (kidNationAllowedParents[referrerOrigin]) kidNationParentOrigin = referrerOrigin;\n"
+            + "      } catch (_) {}\n"
+            + "      const kidNationPostLoaderEvent = (eventName, parameters) => {\n"
+            + "        if (!kidNationParentOrigin || window.parent === window) return;\n"
+            + "        window.parent.postMessage({ source: \"kidnation-worldcup-game\", version: 1, event: eventName, parameters: parameters || {} }, kidNationParentOrigin);\n"
+            + "      };\n"
+            + "      let kidNationLoaderErrorReported = false;\n"
+            + "      new MutationObserver(() => {\n"
+            + "        if (!kidNationLoaderErrorReported && unityError.classList.contains(\"is-visible\")) {\n"
+            + "          kidNationLoaderErrorReported = true;\n"
+            + "          kidNationPostLoaderEvent(\"game_error\", { error_stage: \"unity_loader\", error_code: \"create_instance_failed\" });\n"
+            + "        }\n"
+            + "      }).observe(unityError, { attributes: true, attributeFilter: [\"class\"] });\n";
+        const string analyticsRetryHandler = "      document.querySelector(\"#unity-retry\").addEventListener(\"click\", () => {\n"
+            + "        kidNationPostLoaderEvent(\"retry_click\", { error_stage: \"unity_loader\" });\n"
+            + "        window.location.reload();\n"
+            + "      });";
+
+        if (!html.Contains(analyticsAnchor) || !html.Contains(retryHandler))
+        {
+            throw new BuildFailedException("Unity's WebGL analytics anchors were not found.");
+        }
+
+        html = html.Replace(analyticsAnchor, analyticsAnchor + analyticsBridgeScript);
+        return html.Replace(retryHandler, analyticsRetryHandler);
+    }
